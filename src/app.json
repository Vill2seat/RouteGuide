{
  "expo": {
    "name": "Route Guide",
    "slug": "route-guide",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "url": "https://u.expo.dev/your-project-id"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Route Guide needs access to your location even when the app is closed to record your routes.",
        "NSLocationWhenInUseUsageDescription": "Route Guide needs access to your location to record your route while you're using the app.",
        "UIBackgroundModes": ["location", "fetch"],
        "NSMotionUsageDescription": "Route Guide uses motion data to detect your mode of transport.",
        "NSAppleMusicUsageDescription": false
      },
      "bundleIdentifier": "com.routeguide.app"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.routeguide.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Route Guide needs access to your location even when the app is closed to record your routes."
        }
      ],
      "expo-background-fetch",
      "expo-task-manager"
    ]
  }
}