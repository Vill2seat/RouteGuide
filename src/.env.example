# Optional MapLibre style URL. The default is the free OpenFreeMap Liberty style.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional provider overrides. Free public services can rate limit requests.
EXPO_PUBLIC_ROUTING_ENDPOINT=https://valhalla1.openstreetmap.de/route
EXPO_PUBLIC_AIR_QUALITY_ENDPOINT=https://air-quality-api.open-meteo.com/v1/air-quality
EXPO_PUBLIC_OSM_QUERY_ENDPOINT=https://overpass-api.de/api/interpreter
